<Window x:Class="SpotifyToMp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpotifyToMp3"
        Title="Spotify to MP3"
        Width="1060" Height="770" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True"
        AllowDrop="True" FontFamily="Segoe UI"
        DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <!-- Shiba palette (same as Shibaberg): cream background, white cards, fur orange as the one accent, brown ink text. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#FFF6EA"/>
        <SolidColorBrush x:Key="Surface2" Color="#FBEBD8"/>
        <SolidColorBrush x:Key="Inset" Color="#FFFBF5"/>
        <SolidColorBrush x:Key="BorderC" Color="#EFD9BF"/>
        <SolidColorBrush x:Key="TextC" Color="#3A2418"/>
        <SolidColorBrush x:Key="MutedC" Color="#9B7A60"/>
        <SolidColorBrush x:Key="Accent" Color="#E8924A"/>
        <SolidColorBrush x:Key="Accent2" Color="#C4652A"/>
        <SolidColorBrush x:Key="FurDark" Color="#D27A34"/>
        <SolidColorBrush x:Key="CreamText" Color="#FFF2DF"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#EFD9BF" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#9B7A60"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FBEBD8"/>
                                <Setter Property="Foreground" Value="#3A2418"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D22837"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- big fur-orange button (Patch Game) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E8924A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="12" Background="{TemplateBinding Background}"/>
                            <Border x:Name="hl" CornerRadius="12" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hl" Property="Opacity" Value="0.11"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hl" Property="Opacity" Value="0"/>
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- cream outlined button (Batch Patch...) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3A2418"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="#FBF0E2" BorderBrush="#EFD9BF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FBEBD8"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#E8924A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C4652A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- format pills -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A3E2B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="16" Background="#FBEBD8" BorderBrush="#EFD9BF" BorderThickness="1"
                                Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#E8924A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E8924A"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#E8924A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- white card with a thin tan border, small spaced caps label -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EFD9BF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9B7A60"/>
        </Style>

        <ControlTemplate x:Key="ThinBar" TargetType="ProgressBar">
            <Grid>
                <Border x:Name="PART_Track" Background="Transparent"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#E8924A"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Border CornerRadius="10" Background="{StaticResource Bg}" BorderBrush="#E3C7A6" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= sidebar: fur orange, paws, the shiba ================= -->
            <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="10,0,0,10"
                    MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Grid>
                    <local:PawPrints/>
                    <StackPanel Margin="22,28,22,0">
                        <Grid Width="176" Height="176">
                            <Ellipse Fill="{StaticResource CreamText}"/>
                            <local:ShibaFace x:Name="Mascot" Width="150" Height="150" Margin="0,0,0,10"/>
                        </Grid>
                        <TextBlock Text="Spotify to MP3" FontSize="26" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>

                        <!-- speech bubble with a tail pointing up at the shiba -->
                        <Polygon Points="0,9 9,0 18,9" Fill="White" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <Border Background="White" CornerRadius="14" MinHeight="64" Padding="12,8">
                            <TextBlock x:Name="MascotText" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextC}"
                                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="Woof! Paste a Spotify link and I'll fetch the songs."/>
                        </Border>

                        <!-- three steps, ticked off as they're done -->
                        <StackPanel x:Name="Steps" Margin="12,30,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Grid Width="26" Height="26">
                                    <Ellipse x:Name="Step1Dot" Fill="{StaticResource FurDark}"/>
                                    <TextBlock x:Name="Step1Num" Text="1" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource CreamText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="Step1Text" Text="Paste a Spotify link" Margin="12,0,0,0" FontSize="13"
                                           Foreground="{StaticResource CreamText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Grid Width="26" Height="26">
                                    <Ellipse x:Name="Step2Dot" Fill="{StaticResource FurDark}"/>
                                    <TextBlock x:Name="Step2Num" Text="2" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource CreamText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="Step2Text" Text="Pick a format" Margin="12,0,0,0" FontSize="13"
                                           Foreground="{StaticResource CreamText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="26" Height="26">
                                    <Ellipse x:Name="Step3Dot" Fill="{StaticResource FurDark}"/>
                                    <TextBlock x:Name="Step3Num" Text="3" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource CreamText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="Step3Text" Text="Press Download" Margin="12,0,0,0" FontSize="13"
                                           Foreground="{StaticResource CreamText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="v2.0  ·  made with paws" FontSize="10.5" Foreground="{StaticResource CreamText}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                </Grid>
            </Border>

            <!-- ================= content ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- title bar: drag area + min/close -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                        <Button Style="{StaticResource ChromeButton}" Content="−" Click="Minimize_Click"/>
                        <Button Style="{StaticResource CloseButton}" Content="×" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Let's fetch some songs" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextC}"/>
                        <TextBlock Text="Paste a Spotify link, pick a format, press Download - matching and saving are handled for you."
                                   FontSize="12" Foreground="{StaticResource MutedC}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- drop zone: dashed card with the little shiba + the link box -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Rectangle x:Name="DropRect" RadiusX="14" RadiusY="14" Fill="White" Stroke="#E9C9A6"
                                   StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <Grid Margin="22,16,22,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:ShibaFace x:Name="DropShiba" Width="56" Height="56" VerticalAlignment="Top" Margin="0,2,18,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Drop a Spotify link here" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextC}"/>
                                <TextBlock Text="or paste it below  ·  songs, albums and playlists are detected automatically"
                                           FontSize="11.5" Foreground="{StaticResource MutedC}" Margin="0,3,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="9" Background="{StaticResource Inset}" BorderBrush="{StaticResource BorderC}"
                                            BorderThickness="1" Height="38">
                                        <Grid>
                                            <TextBox x:Name="UrlBox" Background="Transparent" BorderThickness="0" Padding="10,0"
                                                     Foreground="{StaticResource TextC}" CaretBrush="#C4652A" FontSize="13"
                                                     VerticalContentAlignment="Center" KeyDown="UrlBox_KeyDown"/>
                                            <TextBlock Text="https://open.spotify.com/album/..." Margin="13,0" FontSize="13"
                                                       Foreground="#C8B39E" IsHitTestVisible="False" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="PasteButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="38"
                                            Padding="18,0" Margin="10,0,0,0" FontSize="12.5" Content="Paste &amp; load" Click="Paste_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- format + save folder -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="F O R M A T" Style="{StaticResource CardLabel}"/>
                                <StackPanel x:Name="FormatPanel" Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="OriginalRadio" GroupName="fmt" IsChecked="True" Style="{StaticResource Pill}"
                                                 Content="Original M4A" ToolTip="Best quality: YouTube's AAC audio, untouched."/>
                                    <RadioButton x:Name="Mp3320Radio" GroupName="fmt" Style="{StaticResource Pill}" Content="MP3 320"/>
                                    <RadioButton x:Name="Mp3256Radio" GroupName="fmt" Style="{StaticResource Pill}" Content="MP3 256"/>
                                    <RadioButton x:Name="Mp3192Radio" GroupName="fmt" Style="{StaticResource Pill}" Content="MP3 192"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <DockPanel>
                                    <Button x:Name="ChangeFolderButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                            Content="Change ↗" Click="ChangeFolder_Click"/>
                                    <TextBlock Text="S A V E   T O" Style="{StaticResource CardLabel}"/>
                                </DockPanel>
                                <Border CornerRadius="9" Background="{StaticResource Inset}" BorderBrush="{StaticResource BorderC}"
                                        BorderThickness="1" Height="34" Margin="0,10,0,0" Padding="10,0">
                                    <TextBlock x:Name="FolderText" FontSize="12" Foreground="#5A3E2B" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- actions -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Download_Click">
                            <TextBlock x:Name="DownloadLabel" Text="Download"/>
                        </Button>
                        <Button x:Name="CancelButton" Style="{StaticResource PrimaryButton}" Background="#CF4A3F"
                                Content="Stop" Visibility="Collapsed" Click="Cancel_Click"/>
                        <Button x:Name="OpenFolderButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0"
                                Content="Open folder..." Click="OpenFolder_Click"/>
                    </Grid>

                    <!-- tracks (where Shibaberg has its Activity log) -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,16,10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="T R A C K S" Style="{StaticResource CardLabel}"/>

                            <TextBlock x:Name="EmptyState" Grid.Row="1" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12"
                                       Foreground="#B59A82" Text="Nothing fetched yet - drop a Spotify link above to begin."/>

                            <Grid x:Name="ContentPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="KindText" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent2}"/>
                                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextC}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        <TextBlock x:Name="MetaText" FontSize="12" Foreground="{StaticResource MutedC}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="0" Height="1" Background="#F5E6D3" VerticalAlignment="Bottom" Margin="0,0,10,0"/>

                                <ListBox x:Name="TrackList" Grid.Row="1" Margin="0,6,0,0" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="row" CornerRadius="8" Background="Transparent" Padding="8,6" Margin="0,0,8,0">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="#FFF6EA"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontSize="12" Foreground="#B59A82"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#3A2418"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="#9B7A60"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}" FontFamily="Consolas" FontSize="12"
                                                           Foreground="#9B7A60" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- status bar -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderC}" BorderThickness="0,1,0,0" Background="#FBF0E2"
                        CornerRadius="0,0,10,0">
                    <Grid>
                        <ProgressBar x:Name="DownloadBar" Height="2" VerticalAlignment="Top" Minimum="0" Maximum="100"
                                     Template="{StaticResource ThinBar}" Visibility="Hidden"/>
                        <Grid Margin="26,7,26,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9B7A60" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0,16,0" FontSize="12" Foreground="{StaticResource TextC}"
                                       TextTrimming="CharacterEllipsis" Text="Ready"/>
                            <TextBlock x:Name="PercentText" Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent2}"
                                       Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="3" FontSize="11" Foreground="#C8A98C"
                                       Text="spotify metadata · youtube audio · no login"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
